# Copy to .env and fill in. Never commit .env.
# Gemini is used only for column mapping and scanned-page extraction.
GEMINI_API_KEY=

# Model used for column mapping and vision extraction.
LOSSLIFT_GEMINI_MODEL=gemini-2.0-flash

# Set to 1 to allow the LLM to be called for unknown column headers.
# With this off, unmapped columns go to the mapping screen instead.
LOSSLIFT_ENABLE_LLM=0

# Set to 1 to run the tests that call a live Gemini endpoint.
LOSSLIFT_RUN_LLM_TESTS=0
